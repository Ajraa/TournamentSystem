# Zkopíruj tento soubor jako .env a vyplň hodnoty

# Django secret key — vygeneruj vlastní: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-nahrad-me-vlastnim-klicem

# Google OAuth2 credentials z Google Cloud Console
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=tvuj-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tvuj-client-secret
